PORT=3000
HOST=127.0.0.1
# Optional: enable real dialogue with your available Bedrock model or inference profile.
# Credentials use the AWS SDK default provider chain; never put them in browser code.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Optional deployed guardrail; both fields are required to enable it.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Enable only for a controlled HTTPS demo backend serving the native APK.
ALLOW_NATIVE_CLIENT=false
NOVA_SONIC_ENABLED=false
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
POLLY_REGION=us-east-1
OPENROUTER_API_KEY=
JEV_MODEL_ID=~typesafe/jev-latest
# Optional owner-authorized Fire OS developer bridge. Never expose ADB publicly.
HEARTH_TV_ENABLED=false
HEARTH_TV_TOKEN=
HEARTH_TV_ADB_SERIAL=
HEARTH_TV_PRIME_PACKAGE=
HEARTH_TV_EXPIRES_AT=
HEARTH_TV_PROFILE_FILE=data/viewer.json
HEARTH_TV_CATALOG_FILE=
